enclave {
    trusted {
        // JWT to salt conversion function
        public sgx_status_t jwt_to_salt([in, size=len] const uint8_t* some_string, size_t len,
                                       [out, size=16] uint8_t* output_salt);
    };
    
    untrusted {
        // OCALL - print message(for test)
        void ocall_print_message([in, string] const char* message);
    };
};